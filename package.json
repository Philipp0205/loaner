{
  "name": "loaner",
  "version": "1.0.0",
  "private": true,
  "description": "Loaner: lend things to friends in invite-only groups.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "tsx --test --test-concurrency=1 test/ui/*.spec.ts",
    "vapid": "tsx src/vapid.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
